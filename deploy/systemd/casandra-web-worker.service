[Unit]
Description=CasAndra Web scientific worker
Documentation=file:/srv/casandra/releases/backend/current/source/README.md
After=local-fs.target
RequiresMountsFor=/srv/casandra
ConditionPathExists=/etc/casandra-web.env
ConditionPathExists=/etc/casandra-web-runners.json
StartLimitIntervalSec=10min
StartLimitBurst=2

[Service]
Type=exec
User=casandrasvc
Group=casandrasvc
WorkingDirectory=/srv/casandra/releases/backend/current/source
EnvironmentFile=/etc/casandra-web.env
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONSAFEPATH=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT PYTHONBREAKPOINT PYTHONWARNINGS PYTHONUSERBASE LD_PRELOAD LD_LIBRARY_PATH BASH_ENV ENV
ExecStartPre=/usr/bin/test -x /srv/casandra/releases/backend/current/venv/bin/casandra-web-worker
ExecStart=/srv/casandra/releases/backend/current/venv/bin/casandra-web-worker
Restart=on-failure
RestartSec=10s
TimeoutStopSec=90s
KillMode=control-group
UMask=0077

Nice=10
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/srv/casandra/jobs
LimitNOFILE=4096
LimitCORE=0
LimitFSIZE=268435456
TasksMax=192
CPUAccounting=yes
CPUWeight=10
CPUQuota=85%
MemoryAccounting=yes
MemoryHigh=1000M
MemoryMax=1200M
MemorySwapMax=0
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
