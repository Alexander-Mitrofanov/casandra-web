# Installed as /etc/casandra-web.env with root:casandrasvc ownership and 0640 mode.
# The installer replaces both placeholders. Never commit the rendered file.
CASANDRA_WEB_DATA_ROOT=/srv/casandra/jobs
CASANDRA_WEB_DATABASE_PATH=/srv/casandra/jobs/queue.sqlite3
CASANDRA_WEB_TOKEN_PEPPER=__GENERATED_TOKEN_PEPPER__
CASANDRA_WEB_CORS_ORIGINS=__PAGES_ORIGIN__
CASANDRA_WEB_FORWARDED_ALLOW_IPS=127.0.0.1

CASANDRA_WEB_CASANDRA_COMMAND='["/srv/casandra/releases/backend/current/venv/bin/casandra"]'
CASANDRA_WEB_IDENTIFY_COMMAND='["/opt/crispr-workers/integration/bin/crispr-tools"]'
CASANDRA_WEB_IDENTIFY_RUNNER_CONFIG=/etc/casandra-web-runners.json

CASANDRA_WEB_PORT=8010
CASANDRA_WEB_HOST=127.0.0.1
CASANDRA_WEB_MAX_REQUEST_BYTES=110000000
CASANDRA_WEB_MAX_TOTAL_BASES=100000000
CASANDRA_WEB_MAX_RECORD_BASES=100000000
CASANDRA_WEB_MAX_RECORDS=10000
CASANDRA_WEB_MAX_ARRAY_REQUEST_BYTES=4500000
CASANDRA_WEB_MAX_ARRAY_TOTAL_BASES=2000000
CASANDRA_WEB_MAX_ARRAY_RECORDS=20
CASANDRA_WEB_MAX_PROTEIN_REQUEST_BYTES=4500000
CASANDRA_WEB_MAX_TOTAL_RESIDUES=2000000
CASANDRA_WEB_MAX_PROTEIN_RESIDUES=100000
CASANDRA_WEB_MAX_PROTEIN_RECORDS=10000
CASANDRA_WEB_MAX_HEADER_CHARACTERS=200
CASANDRA_WEB_MAX_QUEUED_JOBS=1
CASANDRA_WEB_MAX_ACTIVE_JOBS=2
CASANDRA_WEB_MAX_ACTIVE_PER_CLIENT=1
CASANDRA_WEB_RETENTION_SECONDS=86400

CASANDRA_WEB_WORKER_CPU=3
CASANDRA_WEB_STAGE_TIMEOUT_SECONDS=7200
CASANDRA_WEB_WORKER_POLL_SECONDS=2
CASANDRA_WEB_HEARTBEAT_SECONDS=15
CASANDRA_WEB_WORKER_STALE_SECONDS=90
CASANDRA_WEB_MAX_ATTEMPTS=1
CASANDRA_WEB_MAX_LOG_BYTES=2000000
CASANDRA_WEB_MAX_RETAINED_JOBS=20
CASANDRA_WEB_MAX_RETAINED_INPUT_BASES=250000000
CASANDRA_WEB_SUBMISSION_WINDOW_SECONDS=3600
CASANDRA_WEB_MAX_SUBMISSIONS_PER_WINDOW=3
CASANDRA_WEB_MIN_FREE_BYTES=20000000000
CASANDRA_WEB_MIN_FREE_INODES=100000
CASANDRA_WEB_MAX_JOB_STORAGE_BYTES=2000000000
CASANDRA_WEB_MAX_JOB_LIFETIME_SECONDS=28800
CASANDRA_WEB_PREFLIGHT_SCIENTIFIC_RUNTIME=true
CASANDRA_WEB_CASANDRA_EXPECTED_VERSION=casandra 0.3.0.dev0
CASANDRA_WEB_CASANDRA_BUNDLE_ID=casandra-cas-only-cpu-bundle-v5-type-ii-architecture
CASANDRA_WEB_CASANDRA_BUNDLE_MANIFEST_SHA256=89657480e1135aec57f7e2b4a45fe5150f10fbdcbf80bf640e4325f7b921a071
CASANDRA_WEB_CASANDRA_PROGRAM_VERSION=0.3.0.dev0
CASANDRA_WEB_CASANDRA_SCHEMA_VERSION=5
CASANDRA_WEB_CASANDRA_BUNDLE_ROLE=deployment_refit
CASANDRA_WEB_INTEGRATION_EXPECTED_VERSION=crispr-tools 0.2.6
CASANDRA_WEB_CRISPRIDENTIFY_VERSION_FILE=/opt/crispr-suite/CRISPRidentify/VERSION
CASANDRA_WEB_CRISPRIDENTIFY_EXPECTED_VERSION=2.0.0
LOG_LEVEL=INFO
