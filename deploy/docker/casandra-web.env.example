# Installed as /srv/casandra/config/casandra-web.env with mode 0600.
# prepare-host.sh replaces both placeholders. Never commit the rendered file.
CASANDRA_WEB_DATA_ROOT=/data/jobs
CASANDRA_WEB_DATABASE_PATH=/data/jobs/queue.sqlite3
CASANDRA_WEB_TOKEN_PEPPER=__GENERATED_TOKEN_PEPPER__
CASANDRA_WEB_CORS_ORIGINS=__PAGES_ORIGIN__
CASANDRA_WEB_FORWARDED_ALLOW_IPS=172.30.249.2

CASANDRA_WEB_CASANDRA_COMMAND=["/opt/casandra/venv/bin/casandra"]
CASANDRA_WEB_IDENTIFY_COMMAND=["/opt/integration/venv/bin/crispr-tools"]
CASANDRA_WEB_IDENTIFY_RUNNER_CONFIG=/opt/casandra-web/config/runners.json

CASANDRA_WEB_PORT=8010
CASANDRA_WEB_HOST=0.0.0.0
CASANDRA_WEB_MAX_REQUEST_BYTES=4500000
CASANDRA_WEB_MAX_TOTAL_BASES=2000000
CASANDRA_WEB_MAX_RECORD_BASES=2000000
CASANDRA_WEB_MAX_RECORDS=20
CASANDRA_WEB_MAX_HEADER_CHARACTERS=200
CASANDRA_WEB_MAX_QUEUED_JOBS=2
CASANDRA_WEB_MAX_ACTIVE_JOBS=3
CASANDRA_WEB_MAX_ACTIVE_PER_CLIENT=1
CASANDRA_WEB_RETENTION_SECONDS=86400
CASANDRA_WEB_WORKER_CPU=1
CASANDRA_WEB_STAGE_TIMEOUT_SECONDS=7200
CASANDRA_WEB_WORKER_POLL_SECONDS=2
CASANDRA_WEB_HEARTBEAT_SECONDS=15
CASANDRA_WEB_WORKER_STALE_SECONDS=90
CASANDRA_WEB_MAX_ATTEMPTS=2
CASANDRA_WEB_MAX_LOG_BYTES=2000000
CASANDRA_WEB_MAX_RETAINED_JOBS=20
CASANDRA_WEB_MAX_RETAINED_INPUT_BASES=20000000
CASANDRA_WEB_SUBMISSION_WINDOW_SECONDS=3600
CASANDRA_WEB_MAX_SUBMISSIONS_PER_WINDOW=3
CASANDRA_WEB_MIN_FREE_BYTES=5000000000
CASANDRA_WEB_MIN_FREE_INODES=100000
CASANDRA_WEB_MAX_JOB_STORAGE_BYTES=600000000
CASANDRA_WEB_MAX_JOB_LIFETIME_SECONDS=28800
CASANDRA_WEB_PREFLIGHT_SCIENTIFIC_RUNTIME=true
CASANDRA_WEB_CASANDRA_EXPECTED_VERSION=casandra 0.2.0.dev0
CASANDRA_WEB_INTEGRATION_EXPECTED_VERSION=crispr-tools 0.2.6
CASANDRA_WEB_CRISPRIDENTIFY_VERSION_FILE=/opt/crispridentify/VERSION
CASANDRA_WEB_CRISPRIDENTIFY_EXPECTED_VERSION=2.0.0
LOG_LEVEL=INFO
