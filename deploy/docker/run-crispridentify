#!/bin/sh
set -eu

PATH=${CRISPRIDENTIFY_ENV}/bin:/usr/bin:/bin
export PATH
export PYTHONHASHSEED=0
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
unset PYTHONHOME PYTHONPATH PYTHONSAFEPATH PYTHONSTARTUP PYTHONINSPECT PYTHONBREAKPOINT
unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT BASH_ENV ENV

exec /opt/crispridentify/scripts/run_crispridentify.sh "$@"
