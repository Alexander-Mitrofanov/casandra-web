[Unit]
Description=Remove expired CasAndra Web jobs
Documentation=file:/srv/casandra/releases/backend/current/source/README.md
After=local-fs.target
RequiresMountsFor=/srv/casandra
ConditionPathExists=/etc/casandra-web.env

[Service]
Type=oneshot
User=casandrasvc
Group=casandrasvc
WorkingDirectory=/srv/casandra/releases/backend/current/source
EnvironmentFile=/etc/casandra-web.env
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONSAFEPATH=1
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONINSPECT PYTHONBREAKPOINT PYTHONWARNINGS PYTHONUSERBASE LD_PRELOAD LD_LIBRARY_PATH BASH_ENV ENV
ExecStartPre=/usr/bin/test -x /srv/casandra/releases/backend/current/venv/bin/casandra-web-cleanup
ExecStart=/srv/casandra/releases/backend/current/venv/bin/casandra-web-cleanup
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/srv/casandra/jobs
LimitNOFILE=1024
LimitCORE=0
TasksMax=32
MemoryMax=96M
MemorySwapMax=0
