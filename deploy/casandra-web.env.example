# Installed as /etc/casandra-web.env with root:casandrasvc ownership and 0640 mode.
# The installer replaces both placeholders. Never commit the rendered file.
CASANDRA_WEB_DATA_ROOT=/srv/casandra/jobs
CASANDRA_WEB_DATABASE_PATH=/srv/casandra/jobs/queue.sqlite3
CASANDRA_WEB_TOKEN_PEPPER=__GENERATED_TOKEN_PEPPER__
CASANDRA_WEB_CORS_ORIGINS=__PAGES_ORIGIN__

CASANDRA_WEB_CASANDRA_COMMAND='["/srv/casandra/releases/scientific/current/casandra/bin/casandra"]'
CASANDRA_WEB_IDENTIFY_COMMAND='["/srv/casandra/releases/scientific/current/integration/bin/crispr-tools"]'
CASANDRA_WEB_IDENTIFY_RUNNER_CONFIG=/etc/casandra-web-runners.json

CASANDRA_WEB_PORT=8010
CASANDRA_WEB_MAX_REQUEST_BYTES=4500000
CASANDRA_WEB_MAX_TOTAL_BASES=2000000
CASANDRA_WEB_MAX_RECORD_BASES=2000000
CASANDRA_WEB_MAX_RECORDS=20
CASANDRA_WEB_MAX_HEADER_CHARACTERS=200
CASANDRA_WEB_MAX_QUEUED_JOBS=2
CASANDRA_WEB_MAX_ACTIVE_PER_CLIENT=1
CASANDRA_WEB_RETENTION_SECONDS=86400

CASANDRA_WEB_WORKER_CPU=1
CASANDRA_WEB_STAGE_TIMEOUT_SECONDS=7200
CASANDRA_WEB_WORKER_POLL_SECONDS=2
CASANDRA_WEB_HEARTBEAT_SECONDS=15
CASANDRA_WEB_WORKER_STALE_SECONDS=90
CASANDRA_WEB_MAX_ATTEMPTS=2
CASANDRA_WEB_MAX_LOG_BYTES=2000000
LOG_LEVEL=INFO
